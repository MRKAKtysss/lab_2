#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define MAX_WORDS     8
#define MAX_WORD_LEN  32
#define MAX_LETTERS   10
#define MAX_LINE      256

typedef struct {
    char addends[MAX_WORDS][MAX_WORD_LEN];
    int  num_addends;
    char result[MAX_WORD_LEN];

    char letters[MAX_LETTERS];
    int  num_letters;

    int  is_leading[MAX_LETTERS];
    int  letter_idx[256];

    int  num_cols;
    int  col_addends[MAX_WORD_LEN][MAX_WORDS];
    int  col_num_addends[MAX_WORD_LEN];
    int  col_result[MAX_WORD_LEN];
} Rebus;

static int is_letter_char(char c) { return c >= 'A' && c <= 'Z'; }

static int is_space_char(char c) {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\v';
}

static int parse_rebus(const char* line, Rebus* rebus) {
    memset(rebus, 0, sizeof(*rebus));

    char buf[MAX_LINE];
    strncpy(buf, line, MAX_LINE - 1);
    buf[MAX_LINE - 1] = '\0';

    size_t len = strlen(buf);
    while (len > 0 && (buf[len - 1] == '\n' || buf[len - 1] == '\r' || buf[len - 1] == ' '))
        buf[--len] = '\0';

    char* eq = strchr(buf, '=');
    if (!eq) return 0;
    *eq = '\0';
    char* result = eq + 1;

    char* token = strtok(buf, "+");
    while (token) {
        while (*token == ' ') token++;
        char* end = token + strlen(token) - 1;
        while (end > token && *end == ' ') { *end = '\0'; end--; }

        if (strlen(token) == 0 || strlen(token) >= MAX_WORD_LEN) return 0;
        strcpy(rebus->addends[rebus->num_addends++], token);
        if (rebus->num_addends >= MAX_WORDS) return 0;
        token = strtok(NULL, "+");
    }

    while (*result == ' ') result++;
    char* rend = result + strlen(result) - 1;
    while (rend > result && *rend == ' ') { *rend = '\0'; rend--; }
    if (strlen(result) == 0 || strlen(result) >= MAX_WORD_LEN) return 0;
    strcpy(rebus->result, result);

    for (int i = 0; i < 256; i++) rebus->letter_idx[i] = -1;

    for (int i = 0; i < rebus->num_addends; i++)
        for (char* c = rebus->addends[i]; *c; c++)
            if (is_letter_char(*c) && rebus->letter_idx[(unsigned char)*c] < 0) {
                rebus->letter_idx[(unsigned char)*c] = rebus->num_letters;
                rebus->letters[rebus->num_letters++] = *c;
            }

    for (char* c = rebus->result; *c; c++)
        if (is_letter_char(*c) && rebus->letter_idx[(unsigned char)*c] < 0) {
            rebus->letter_idx[(unsigned char)*c] = rebus->num_letters;
            rebus->letters[rebus->num_letters++] = *c;
        }

    for (int i = 0; i < rebus->num_letters; i++)
        rebus->is_leading[i] = 0;

    for (int i = 0; i < rebus->num_addends; i++) {
        const char* w = rebus->addends[i];
        if (strlen(w) > 1)
            rebus->is_leading[rebus->letter_idx[(unsigned char)w[0]]] = 1;
    }
    if (strlen(rebus->result) > 1)
        rebus->is_leading[rebus->letter_idx[(unsigned char)rebus->result[0]]] = 1;

    int rlen = (int)strlen(rebus->result);
    int max_len = rlen;
    for (int i = 0; i < rebus->num_addends; i++) {
        int wlen = (int)strlen(rebus->addends[i]);
        if (wlen > max_len) max_len = wlen;
    }
    rebus->num_cols = max_len;

    for (int c = 0; c < max_len; c++) {
        rebus->col_num_addends[c] = 0;
        rebus->col_result[c] = -1;
    }

    for (int i = 0; i < rebus->num_addends; i++) {
        int wlen = (int)strlen(rebus->addends[i]);
        for (int p = 0; p < wlen; p++) {
            char ch = rebus->addends[i][wlen - 1 - p];
            int L = rebus->letter_idx[(unsigned char)ch];
            rebus->col_addends[p][rebus->col_num_addends[p]++] = L;
        }
    }

    for (int p = 0; p < rlen; p++) {
        char ch = rebus->result[rlen - 1 - p];
        rebus->col_result[p] = rebus->letter_idx[(unsigned char)ch];
    }

    return rebus->num_addends >= 2 && rebus->num_letters <= MAX_LETTERS;
}

static long long word_value(const char* word, const int* digits, const Rebus* rebus) {
    long long v = 0;
    for (const char* c = word; *c; c++)
        v = v * 10 + digits[rebus->letter_idx[(unsigned char)*c]];
    return v;
}

static int digits[MAX_LETTERS]; 
static int used[10];

static int solve_column(const Rebus* rebus, int col, int carry);

static int try_assign(const Rebus* rebus, int col, int carry,
    const int* list, int n, int idx) {
    if (idx == n) {
        int sum = carry;
        for (int k = 0; k < rebus->col_num_addends[col]; k++)
            sum += digits[rebus->col_addends[col][k]];

        int res = sum % 10;
        int new_carry = sum / 10;

        int rl = rebus->col_result[col];
        if (rl < 0) {
            if (res != 0) return 0;
            return solve_column(rebus, col + 1, new_carry);
        }
        if (digits[rl] >= 0) {
            if (digits[rl] != res) return 0;
            return solve_column(rebus, col + 1, new_carry);
        }
        if (used[res]) return 0;
        if (res == 0 && rebus->is_leading[rl]) return 0;
        digits[rl] = res;
        used[res] = 1;
        if (solve_column(rebus, col + 1, new_carry)) return 1;
        used[res] = 0;
        digits[rl] = -1;
        return 0;
    }

    int L = list[idx];
    for (int d = 0; d <= 9; d++) {
        if (used[d]) continue;
        if (d == 0 && rebus->is_leading[L]) continue;
        digits[L] = d;
        used[d] = 1;
        if (try_assign(rebus, col, carry, list, n, idx + 1)) return 1;
        used[d] = 0;
        digits[L] = -1;
    }
    return 0;
}

static int solve_column(const Rebus* rebus, int col, int carry) {
    if (col == rebus->num_cols)
        return carry == 0;
    int list[MAX_LETTERS];
    int n = 0;
    for (int k = 0; k < rebus->col_num_addends[col]; k++) {
        int L = rebus->col_addends[col][k];
        if (digits[L] < 0) {
            int dup = 0;
            for (int j = 0; j < n; j++) if (list[j] == L) { dup = 1; break; }
            if (!dup) list[n++] = L;
        }
    }

    return try_assign(rebus, col, carry, list, n, 0);
}

static int solve(const Rebus* rebus) {
    memset(used, 0, sizeof(used));
    for (int i = 0; i < MAX_LETTERS; i++) digits[i] = -1;
    return solve_column(rebus, 0, 0);
}

static void print_solution(const Rebus* rebus, const int* digits) {
    for (int i = 0; i < rebus->num_addends; i++) {
        if (i > 0) printf(" + ");
        printf("%lld", word_value(rebus->addends[i], digits, rebus));
    }
    printf(" = %lld\n", word_value(rebus->result, digits, rebus));
}

static void process_line(const char* line) {
    Rebus rebus;
    if (!parse_rebus(line, &rebus)) {
        fprintf(stderr, "Parse error: %s", line);
        return;
    }

    clock_t start = clock();
    int ok = solve(&rebus);
    clock_t end = clock();

    double elapsed = (double)(end - start) / CLOCKS_PER_SEC;

    if (ok)
        print_solution(&rebus, digits);
    else
        printf("No solution: %s", line);

    printf("Time: %.6f s\n", elapsed);
}

static void run_keyboard_mode(void) {
    printf("Enter rebuses (empty string - exit):\n");

    char line[MAX_LINE];
    while (fgets(line, sizeof(line), stdin)) {
        int empty = 1;
        for (char* c = line; *c; c++)
            if (!is_space_char(*c)) { empty = 0; break; }
        if (empty) break;

        process_line(line);
        printf("\n");
    }
}

static void run_file_mode(const char* path) {
    FILE* fp = fopen(path, "r");
    if (!fp) { perror(path); return; }

    char line[MAX_LINE];
    while (fgets(line, sizeof(line), fp))
        process_line(line);

    fclose(fp);
}

int main(int argc, char* argv[]) {
    if (argc > 1) {
        run_file_mode(argv[1]);
        return 0;
    }

    printf("Choose:\n");
    printf("1 - Enter rebus with keyboard\n");
    printf("2 - Read from file\n");
    printf("0 - Exit\n\n");
    fflush(stdout);

    int mode = 0;
    if (scanf("%d", &mode) != 1) {
        fprintf(stderr, "Incorrect choice\n");
        return 1;
    }
    int ch;
    while ((ch = getchar()) != '\n' && ch != EOF) {}

    if (mode == 0) return 0;

    if (mode == 1) {
        run_keyboard_mode();
    }
    else if (mode == 2) {
        char path[MAX_LINE];
        printf("File path: ");
        fflush(stdout);
        if (!fgets(path, sizeof(path), stdin)) return 1;

        size_t n = strlen(path);
        while (n > 0 && (path[n - 1] == '\n' || path[n - 1] == '\r'))
            path[--n] = '\0';

        run_file_mode(path);
    }
    else {
        fprintf(stderr, "Unknown mode: %d\n", mode);
        return 1;
    }

    return 0;
}
